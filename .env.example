# 1Click Swap API key (partners.near-intents.org). Without one, 1Click charges its default fee.
ONECLICK_API_KEY=

# NEAR Intents Explorer API JWT (partners.near-intents.org). Required for live crowd data.
# Leave empty to run the server on clearly labelled demo flows instead.
EXPLORER_JWT=

# Port for the Crowdline server
PORT=8787

# Optional: share cached Explorer reads across server instances (Upstash Redis / Vercel KV).
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: lightwalletd for refund recovery (default zec.rocks:443)
LIGHTWALLETD_HOST=
